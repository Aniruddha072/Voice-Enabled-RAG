# Informational for now. Real dev/prod branching gets added only if the
# project actually needs it later.
ENVIRONMENT=development

# Log level for the app's own loggers.
LOG_LEVEL=INFO

# Qdrant REST endpoint. Matches the port docker-compose.yml exposes.
QDRANT_URL=http://localhost:6333

# One collection holds both languages, filtered by a language payload
# field on each point. See docs/architecture.md.
QDRANT_COLLECTION_NAME=voicerag
